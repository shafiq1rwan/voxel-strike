{
  "name": "voxelstrike",
  "private": true,
  "version": "0.3.3",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:poki": "vite --mode poki",
    "build": "tsc --noEmit && vite build",
    "build:poki": "tsc --noEmit && vite build --mode poki",
    "zip:poki": "npm version patch --no-git-tag-version && npm run build:poki && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/zip-poki.ps1",
    "preview": "vite preview",
    "preview:poki": "vite preview --mode poki"
  },
  "devDependencies": {
    "@types/three": "^0.170.0",
    "pngjs": "^7.0.0",
    "puppeteer-core": "^25.8.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  },
  "dependencies": {
    "@fortawesome/free-solid-svg-icons": "^6.7.2",
    "peerjs": "^1.5.5",
    "three": "^0.170.0"
  }
}
